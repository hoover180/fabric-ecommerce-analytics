table _Measures
	lineageTag: 579dda71-774e-43bc-a805-d9d3431859e0
	sourceLineageTag: [Gold].[_Measures]

	/// Total order revenue, de-duplicated to order grain. payment_value is order-level data broadcast across item-grain fact_orders rows; SUMX over distinct order_id with CALCULATE(MAX(...)) prevents double-counting multi-item orders. Validated: R$15,846,280.17 unfiltered.
	measure 'Total Revenue' = SUMX(VALUES(fact_orders[order_id]), CALCULATE(MAX(fact_orders[payment_value])))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Revenue
		lineageTag: 39a3bcc5-22e5-43e9-9133-a2d2e248d535

		changedProperty = Name

		changedProperty = Description

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Year-over-year change in Total Revenue vs. the same period last year. Requires dim_date marked as Date Table. Blank wherever no prior-year data exists in the selected period.
	measure 'YoY Revenue' = [Total Revenue] - CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Revenue
		lineageTag: cdd504e2-71d4-4332-b432-d4899ce98eb9

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// YoY Revenue expressed as a percentage of the prior-year period's revenue. Undefined (blank) wherever the selected period has no corresponding prior-year data — not only the dataset's earliest period specifically.
	measure 'YoY Revenue %' = DIVIDE([YoY Revenue], CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Revenue
		lineageTag: d3bb19ab-e819-49ad-a7f0-0d6c5d46bb9b

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders (order_id). Lower than the fact row count (112,650) because fact grain is order-item, not order. Validated: 98,666 unfiltered.
	measure 'Total Orders' = DISTINCTCOUNT(fact_orders[order_id])
		formatString: #,0
		displayFolder: Delivery
		lineageTag: eff7b9bc-9302-4619-a0f2-ffa4ebadf623

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders where is_late = 1.
	measure 'Late Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_orders[order_id]),
			    fact_orders[is_late] = 1
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 6f938d9e-cc69-4aae-947b-7a52faf84980

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Percentage of delivered orders that arrived on or before the estimated date. Denominator restricted to is_delivered = 1 — non-delivered orders (cancelled, unavailable, in-transit) are correctly excluded rather than implicitly counted as "on-time." Late Orders reused as-is for the numerator since is_late = 1 can only occur on an already-delivered order.
	measure 'On-Time Delivery Rate' =
			
			VAR DeliveredOrders = CALCULATE([Total Orders], fact_orders[is_delivered] = 1)
			RETURN
			    DIVIDE(DeliveredOrders - [Late Orders], DeliveredOrders)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 0f34fa43-f954-49b3-a510-e36331f78a4d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

	/// Average days from order purchase to customer delivery, order-grain corrected. delivery_days is broadcast across item rows; AVERAGEX over distinct order_id prevents multi-item orders from being overweighted.
	measure 'Avg Delivery Days' =
			
			AVERAGEX(
			    VALUES(fact_orders[order_id]),
			    CALCULATE(MAX(fact_orders[delivery_days]))
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 616e0d98-c8f0-40ed-80a0-39f622823bdb

		changedProperty = Name

		changedProperty = Description

		changedProperty = DisplayFolder

		changedProperty = FormatString

	/// Average days late, restricted to late orders only. Pre-filters the iteration table to late orders (~7,827 of 98,666) via CALCULATETABLE before iterating, rather than scanning all orders.
	measure 'Avg Days Late' =
			
			AVERAGEX(
			    CALCULATETABLE(VALUES(fact_orders[order_id]), fact_orders[is_late] = 1),
			    CALCULATE(MAX(fact_orders[days_late]))
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 381969ea-0a49-4719-8186-b7c96dd5204d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders physically delivered within the selected date period. Activates the inactive delivery_date_key relationship for this measure only — USERELATIONSHIP replaces (not adds to) the default order_date_key propagation for the scope of this calculation.
	measure 'Orders Delivered' =
			
			CALCULATE(
			    [Total Orders],
			    USERELATIONSHIP(fact_orders[delivery_date_key], dim_date[date_key]),
			    NOT(ISBLANK(fact_orders[delivery_date_key]))
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 2853eb76-5e87-4580-8a95-9927335d1d5b

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Average review score (1-5), order-grain corrected. AVERAGEX over distinct order_id with CALCULATE(MAX(review_score)) prevents multi-item orders from being overweighted, since review_score is order-level data broadcast across item-grain fact_orders rows.
	measure 'Avg Review Score' =
			
			AVERAGEX(
			    VALUES(fact_orders[order_id]),
			    CALCULATE(MAX(fact_orders[review_score]))
			)
		formatString: 0.00
		displayFolder: Quality
		lineageTag: 8fdc023a-3eb7-43c3-915a-8adcde883e62

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Avg Review Score filtered to delivered orders only. Deliberate exception to the general "include all statuses" policy — satisfaction is a delivery-outcome question, not a revenue-inclusion question.
	measure 'Avg Review Score - Delivered' =
			
			CALCULATE([Avg Review Score], fact_orders[order_status] = "delivered")
		formatString: 0.00
		displayFolder: Quality
		lineageTag: 7cb32c49-67f0-4508-99f4-85453206eb05

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

	/// Trailing 3-month average review score, ending on the last date in the current filter context. Purchase-dated (uses the active order_date_key relationship) — "orders placed in the last 3 months," not "reviews received in the last 3 months."
	measure 'Review Score Rolling 3M' =
			
			CALCULATE(
			    [Avg Review Score],
			    DATESINPERIOD(dim_date[full_date], LASTDATE(dim_date[full_date]), -3, MONTH)
			)
		formatString: 0.00
		displayFolder: Quality
		lineageTag: 18f76cf9-ecbd-455b-b9fd-66d2c0fa39f3

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct customers (customer_key), which is derived from customer_unique_id — the real person, not the order-scoped customer_id.
	measure 'Total Customers' = DISTINCTCOUNT(fact_orders[customer_key])
		formatString: #,0
		displayFolder: Customer
		lineageTag: 7ff1d2ca-f19c-42cb-9828-a8182627f15c

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Percentage of customers with 2+ distinct orders in the current filter context. Period-aware, not lifetime — will change under a date slicer. customer_key verified derived from customer_unique_id.
	measure 'Repeat Customer Rate' =
			
			VAR CustomerOrderCounts =
			    ADDCOLUMNS(
			        VALUES(fact_orders[customer_key]),
			        "cnt", CALCULATE(DISTINCTCOUNT(fact_orders[order_id]))
			    )
			VAR RepeatCustomers = COUNTROWS(FILTER(CustomerOrderCounts, [cnt] >= 2))
			VAR TotalCustomers = COUNTROWS(CustomerOrderCounts)
			RETURN
			    DIVIDE(RepeatCustomers, TotalCustomers)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customer
		lineageTag: 3b53702b-ea44-47e7-aba1-f2af8b79157f

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Revenue per customer in the current filter context (Total Revenue / Total Customers).
	measure 'Avg Revenue per Customer' = DIVIDE([Total Revenue], [Total Customers])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Customer
		lineageTag: 06d1f2cf-3352-4b43-a821-b4246d486656

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Total Revenue divided by Total Orders.
	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Customer
		lineageTag: 8d6f7b11-c0f9-47c7-91b3-be9e2ade7dd5

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Static count of every seller in the dimension (3,095). Does NOT respond to date/period filters — dim_sellers has no incoming filter path from fact-side filters under this model's single cross-filter direction.
	measure 'Total Sellers' = DISTINCTCOUNT(dim_sellers[seller_id])
		formatString: #,0
		displayFolder: Seller
		lineageTag: 48b40ecb-d4c7-4ee0-afd1-bced8b423936

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Average on-time delivery rate across sellers. Reads the pre-aggregated Gold-layer column (dim_sellers.on_time_rate) directly rather than recomputing from fact_orders -- deduplicated to seller-order grain and restricted to delivered orders only in the Gold SQL.
	/// 
	/// LIFETIME ATTRIBUTE: does not respond to date/period filters, same reason as Total Sellers.
	measure 'Seller SLA Compliance' = AVERAGE(dim_sellers[on_time_rate])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Seller
		lineageTag: 84cde6a0-0af4-4139-af21-e0ac33b1cf8c

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

	/// Percentage of sellers whose lifetime SLA bucket falls below 80% (sla_compliance_bucket = "0-60%" or "60-80%"). Denominator restricted to sellers with a measurable on_time_rate (2,970 of 3,095) rather than all sellers -- the 125 sellers with zero delivered orders can never appear in the numerator bucket set, but would otherwise silently dilute the percentage if left in the denominator too.
	/// 
	/// Same lifetime caveat as Seller SLA Compliance: does not respond to date/period filters.
	measure '% Sellers Below 80% SLA' =
			
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(dim_sellers[seller_id]), dim_sellers[sla_compliance_bucket] IN {"0-60%", "60-80%"}),
			    CALCULATE(DISTINCTCOUNT(dim_sellers[seller_id]), NOT ISBLANK(dim_sellers[on_time_rate]))
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Seller
		lineageTag: c1cf1970-d9c6-46a8-8d79-1509c48faf91

		changedProperty = Name

		changedProperty = DisplayFolder

		changedProperty = FormatString

		changedProperty = Description

	column dummy_column
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 06755fa8-fb99-4ee0-89bc-63252e1304e3
		sourceLineageTag: dummy_column
		summarizeBy: none
		sourceColumn: dummy_column

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = entity
		mode: directLake
		source
			entityName: _Measures
			schemaName: Gold
			expressionSource: 'DirectLake - ecommerce_warehouse'

