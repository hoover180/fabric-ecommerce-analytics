table _Measures
	lineageTag: 579dda71-774e-43bc-a805-d9d3431859e0
	sourceLineageTag: [Gold].[_Measures]

	/// Total order revenue, de-duplicated to order grain. payment_value is order-level data broadcast across item-grain fact_orders rows; SUMX over distinct order_id with CALCULATE(MAX(...)) prevents double-counting multi-item orders. Validated: R$15,846,280.17 unfiltered.
	measure 'Total Revenue' = SUMX(VALUES(fact_orders[order_id]), CALCULATE(MAX(fact_orders[payment_value])))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Revenue
		lineageTag: 39a3bcc5-22e5-43e9-9133-a2d2e248d535

		changedProperty = Name

		changedProperty = Description

		changedProperty = DisplayFolder

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Year-over-year change in Total Revenue vs. the same period last year. Requires dim_date marked as Date Table. Blank wherever no prior-year data exists in the selected period.
	measure 'YoY Revenue' = [Total Revenue] - CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Revenue
		lineageTag: cdd504e2-71d4-4332-b432-d4899ce98eb9

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// YoY Revenue expressed as a percentage of the prior-year period's revenue. Undefined (blank) wherever the selected period has no corresponding prior-year data — not only the dataset's earliest period specifically.
	measure 'YoY Revenue %' = DIVIDE([YoY Revenue], CALCULATE([Total Revenue], SAMEPERIODLASTYEAR(dim_date[full_date])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Revenue
		lineageTag: d3bb19ab-e819-49ad-a7f0-0d6c5d46bb9b

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders (order_id). Lower than the fact row count (112,650) because fact grain is order-item, not order. Validated: 98,666 unfiltered.
	measure 'Total Orders' = DISTINCTCOUNT(fact_orders[order_id])
		formatString: #,0
		displayFolder: Delivery
		lineageTag: eff7b9bc-9302-4619-a0f2-ffa4ebadf623

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders where is_late = 1.
	measure 'Late Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(fact_orders[order_id]),
			    fact_orders[is_late] = 1
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 6f938d9e-cc69-4aae-947b-7a52faf84980

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Percentage of delivered orders that arrived on or before the estimated date. Denominator restricted to is_delivered = 1 — non-delivered orders (cancelled, unavailable, in-transit) are correctly excluded rather than implicitly counted as "on-time." Late Orders reused as-is for the numerator since is_late = 1 can only occur on an already-delivered order.
	measure 'On-Time Delivery Rate' =
			
			VAR DeliveredOrders = CALCULATE([Total Orders], fact_orders[is_delivered] = 1)
			RETURN
			    DIVIDE(DeliveredOrders - [Late Orders], DeliveredOrders)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 0f34fa43-f954-49b3-a510-e36331f78a4d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = DisplayFolder

		changedProperty = Description

	/// Average days from order purchase to customer delivery, order-grain corrected. delivery_days is broadcast across item rows; AVERAGEX over distinct order_id prevents multi-item orders from being overweighted.
	measure 'Avg Delivery Days' =
			
			AVERAGEX(
			    VALUES(fact_orders[order_id]),
			    CALCULATE(MAX(fact_orders[delivery_days]))
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 616e0d98-c8f0-40ed-80a0-39f622823bdb

		changedProperty = Name

		changedProperty = Description

		changedProperty = DisplayFolder

		changedProperty = FormatString

	/// Average days late, restricted to late orders only. Pre-filters the iteration table to late orders (~7,827 of 98,666) via CALCULATETABLE before iterating, rather than scanning all orders.
	measure 'Avg Days Late' =
			
			AVERAGEX(
			    CALCULATETABLE(VALUES(fact_orders[order_id]), fact_orders[is_late] = 1),
			    CALCULATE(MAX(fact_orders[days_late]))
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: 381969ea-0a49-4719-8186-b7c96dd5204d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	/// Count of distinct orders physically delivered within the selected date period. Activates the inactive delivery_date_key relationship for this measure only — USERELATIONSHIP replaces (not adds to) the default order_date_key propagation for the scope of this calculation.
	measure 'Orders Delivered' =
			
			CALCULATE(
			    [Total Orders],
			    USERELATIONSHIP(fact_orders[delivery_date_key], dim_date[date_key]),
			    NOT(ISBLANK(fact_orders[delivery_date_key]))
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 2853eb76-5e87-4580-8a95-9927335d1d5b

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = DisplayFolder

	column dummy_column
		dataType: boolean
		isHidden
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 06755fa8-fb99-4ee0-89bc-63252e1304e3
		sourceLineageTag: dummy_column
		summarizeBy: none
		sourceColumn: dummy_column

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition _Measures = entity
		mode: directLake
		source
			entityName: _Measures
			schemaName: Gold
			expressionSource: 'DirectLake - ecommerce_warehouse'

