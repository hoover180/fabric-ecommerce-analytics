                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": " is ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": "nearly double São Paulo's (5.7)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": ", despite similar infrastructure. SP handles roughly ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": "3× RJ's volume",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": " while maintaining the marketplace's most reliable carrier performance.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "RJ's variance spiked in ",
