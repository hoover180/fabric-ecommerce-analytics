    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Key Finding:",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Customer satisfaction drops sharply once a delivery is late — ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": "falling 16% in the first 3 days (4.29 → 3.59)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": ", followed by ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": "another 40% decline in days 4-6 (3.59 → 2.17)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": " — the steepest incremental decline — before leveling off around 1.73 for deliveries 7+ days late. This suggests the highest-leverage window for intervention is the 3-6 day range, not the earliest signs of lateness",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Monthly average delivery time and review score are ",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": "strongly inversely associated (r = -0.89)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "16pt"
                    }
                  },
                  {
                    "value": ", indicating that months with longer delivery times consistently experienced lower customer satisfaction.",
                    "textStyle": {
                      "fontSize": "16pt"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
